{# Huawei VRP interface config lines (use with parents: "interface {{ item.name }}").
   Expected item: name, description?, enabled?, mode?, access?: { vlan }, trunk?: { allowed_vlans }, ip?: { address, mask }. #}
{% if item.description is defined and item.description %}
description {{ item.description }}
{% endif %}
{% if item.enabled is defined %}
{% if item.enabled == false %}
shutdown
{% else %}
undo shutdown
{% endif %}
{% endif %}
{% if item.mode is defined and item.mode == 'access' and item.access is defined %}
port link-type access
port default vlan {{ item.access.vlan }}
{% elif item.mode is defined and item.mode == 'trunk' and item.trunk is defined %}
port link-type trunk
port trunk allow-pass vlan {{ item.trunk.allowed_vlans | default(item.trunk.allow_pass_vlans) | default([]) | map('string') | join(' ') }}
{% endif %}
{% if item.ip is defined and item.ip and item.ip.address is defined %}
ip address {{ item.ip.address }} {{ item.ip.mask | default(item.ip.netmask) | default('255.255.255.0') }}
{% endif %}
