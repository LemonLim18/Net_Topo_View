{
  "_meta": {
    "description": "Legacy structural hints for tools and humans. Authoritative required/optional parameters are ONLY in intent_schemas/<action>.yml. Category → operations mapping: intent_graph.yml. Editable keywords: intent_keywords.yml.",
    "see_also": [
      "intent_graph.yml",
      "intent_keywords.yml",
      "category_schemas/",
      "intent_schemas/"
    ]
  },
  "intent_tree": {
    "target_devices": {
      "required": true,
      "description": "Devices where the operation will be applied (same concept as API target_hosts after mapping).",
      "resolution": {
        "source": ["user_input", "inventory", "topology"],
        "strategy": ["exact_match", "group_match", "numeric_selector_resolution"]
      }
    },
    "vlan": {
      "documentation_only": true,
      "note": "VLAN database operation create_vlan — required vlan_id, vlan_name, target_devices per intent_schemas/create_vlan.yml",
      "interface_expansion": "L2 port work uses configure_interface under category interface"
    },
    "interface": {
      "documentation_only": true,
      "note": "Operations shutdown_interface, configure_interface — see intent_schemas/*.yml",
      "children": {
        "interfaces": {
          "expand_if": "interfaces == 'all'",
          "fields": {
            "name": { "required": true },
            "mode": {
              "required": false,
              "enum": ["access", "trunk", "routed"]
            },
            "admin_state": {
              "required": false,
              "enum": ["up", "down"]
            },
            "description": { "required": false },
            "ip_address": { "required": false },
            "subnet_mask": { "required_if": "ip_address != null" }
          }
        }
      }
    },
    "static_route": {
      "documentation_only": true,
      "note": "Operation configure_static_route — see intent_schemas/configure_static_route.yml"
    },
    "acl": {
      "documentation_only": true,
      "note": "Operation configure_acl — see intent_schemas/configure_acl.yml"
    },
    "qos": {
      "documentation_only": true,
      "note": "Operation configure_qos — see intent_schemas/configure_qos.yml"
    },
    "ospf": {
      "documentation_only": true,
      "note": "Operation configure_ospf — see intent_schemas/configure_ospf.yml"
    }
  }
}
