{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy_name": { "type": "string", "minLength": 1 },
    "interface_apply": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object" }
        ]
      }
    },
    "direction": {
      "type": "string",
      "enum": ["in", "out", "inbound", "outbound"]
    }
  },
  "required": ["target_hosts", "policy_name", "interface_apply"]
}
