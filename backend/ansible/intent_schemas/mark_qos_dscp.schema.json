{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "marking_dscp": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "traffic_type": { "type": "string", "minLength": 1 },
    "policy_name": { "type": "string", "minLength": 1 },
    "interface_apply": {},
    "direction": {
      "type": "string",
      "enum": ["in", "out", "inbound", "outbound"]
    }
  },
  "required": ["target_hosts", "marking_dscp", "traffic_type"]
}
