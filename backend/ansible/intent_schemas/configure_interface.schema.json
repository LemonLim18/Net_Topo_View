{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["access", "trunk", "routed"] },
          "access_vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
          "trunk_vlans": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 4094 } },
          "native_vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
          "admin_state": { "type": "string", "enum": ["up", "down"] },
          "description": { "type": "string" }
        },
        "required": ["name", "mode"]
      }
    }
  },
  "required": ["target_hosts", "interfaces"]
}
