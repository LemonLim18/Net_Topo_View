{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["access", "trunk", "routed"] },
          "access_vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
          "trunk_vlans": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 4094 } },
          "native_vlan": {
            "anyOf": [
              { "type": "integer", "minimum": 1, "maximum": 4094 },
              { "type": "null" }
            ]
          },
          "admin_state": { "type": "string", "enum": ["up", "down"] },
          "ip_address": { "type": "string", "minLength": 1 },
          "subnet_mask": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        },
        "required": ["name", "mode"],
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "access" } } },
            "then": { "required": ["access_vlan"] }
          },
          {
            "if": { "properties": { "mode": { "const": "trunk" } } },
            "then": { "required": ["trunk_vlans"] }
          },
          {
            "if": { "required": ["ip_address"] },
            "then": { "required": ["subnet_mask"] }
          }
        ]
      }
    }
  },
  "required": ["target_hosts", "interfaces"]
}
