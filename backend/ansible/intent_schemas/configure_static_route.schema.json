{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "destination": { "type": "string", "minLength": 1 },
    "next_hop": { "type": "string", "minLength": 1 },
    "admin_distance": { "type": "integer", "minimum": 0, "maximum": 255 },
    "vrf_name": { "type": "string" }
  },
  "required": ["target_hosts", "destination", "next_hop"]
}
