{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy_name": { "type": "string", "minLength": 1 },
    "qos_type": {
      "type": "string",
      "enum": ["class-map", "policy-map", "service-policy"]
    },
    "direction": {
      "type": "string",
      "enum": ["in", "out", "inbound", "outbound"]
    },
    "classification_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object" }
        ]
      }
    },
    "interface_apply": {},
    "marking_dscp": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 63 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "traffic_type": { "type": "string", "minLength": 1 },
    "police_rate": { "type": "string", "minLength": 1 }
  },
  "required": ["target_hosts", "policy_name"]
}
