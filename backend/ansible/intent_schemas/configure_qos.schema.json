{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy_name": { "type": "string", "minLength": 1 },
    "qos_type": {
      "type": "string",
      "enum": ["class-map", "policy-map", "service-policy"]
    },
    "classification_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object" }
        ]
      }
    },
    "interface_apply": {}
  },
  "required": ["target_hosts", "policy_name", "qos_type", "classification_rules"]
}
