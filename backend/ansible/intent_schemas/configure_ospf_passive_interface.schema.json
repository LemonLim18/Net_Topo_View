{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "target_hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "process_id": { "type": "integer", "minimum": 0 },
    "passive_interfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "router_id": { "type": "string" }
  },
  "required": ["target_hosts", "process_id", "passive_interfaces"]
}
