router bgp {{ asn }}
 bgp router-id {{ router_id }}
{% if address_family is defined and address_family %}
 address-family {{ address_family }} unicast
{% endif %}
{% for neighbor in neighbors %}
 neighbor {{ neighbor.ip }} remote-as {{ neighbor.remote_as }}
{% if neighbor.description is defined and neighbor.description %}
 neighbor {{ neighbor.ip }} description {{ neighbor.description }}
{% endif %}
{% if neighbor.update_source is defined and neighbor.update_source %}
 neighbor {{ neighbor.ip }} update-source {{ neighbor.update_source }}
{% endif %}
{% endfor %}
{% if networks is defined and networks %}
{% for net in networks %}
 network {{ net.prefix }} mask {{ net.mask }}
{% endfor %}
{% endif %}
!
