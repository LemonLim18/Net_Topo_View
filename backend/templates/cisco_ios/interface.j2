interface {{ name }}
{% if description is defined and description %}
 description {{ description }}
{% endif %}
{% if ip_address is defined and ip_address and subnet_mask is defined and subnet_mask %}
 ip address {{ ip_address }} {{ subnet_mask }}
{% endif %}
{% if speed is defined and speed %}
 speed {{ speed }}
{% endif %}
{% if duplex is defined and duplex %}
 duplex {{ duplex }}
{% endif %}
{% if mtu is defined and mtu %}
 mtu {{ mtu }}
{% endif %}
{% if vlan is defined and vlan %}
 switchport mode access
 switchport access vlan {{ vlan }}
{% endif %}
{% if mode is defined and mode == 'trunk' %}
 switchport trunk encapsulation dot1q
 switchport mode trunk
{% if trunk_allowed_vlans is defined and trunk_allowed_vlans %}
 switchport trunk allowed vlan {{ trunk_allowed_vlans }}
{% endif %}
{% if trunk_native_vlan is defined and trunk_native_vlan %}
 switchport trunk native vlan {{ trunk_native_vlan }}
{% endif %}
{% endif %}
{% if shutdown is defined and shutdown %}
 shutdown
{% else %}
 no shutdown
{% endif %}
!
