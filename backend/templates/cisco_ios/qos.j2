{# M18: QoS Policy — Cisco IOS (Modular QoS CLI) #}
{# Implements the 5-step QoS model: Classify → Mark → Police/Shape → Queue → Schedule #}

{# ── Step 1: Classification (Class Maps) ── #}
{% for c_map in class_maps %}
class-map match-any {{ c_map.name }}
{% for match in c_map.matches %}
 match {{ match.type }} {{ match.value }}
{% endfor %}
!
{% endfor %}

{# ── Steps 2-5: Marking, Policing/Shaping, Queuing, Scheduling (Policy Map) ── #}
policy-map {{ policy_name }}
{% for p_class in policy_classes %}
 class {{ p_class.class_name }}
{% if p_class.dscp is defined and p_class.dscp %}
  set dscp {{ p_class.dscp }}
{% endif %}
{% if p_class.priority_percent is defined and p_class.priority_percent %}
  priority percent {{ p_class.priority_percent }}
{% elif p_class.bandwidth_percent is defined and p_class.bandwidth_percent %}
  bandwidth percent {{ p_class.bandwidth_percent }}
{% endif %}
{% if p_class.police_rate is defined and p_class.police_rate %}
  police {{ p_class.police_rate }} conform-action transmit exceed-action drop
{% endif %}
{% if p_class.shape_average is defined and p_class.shape_average %}
  shape average {{ p_class.shape_average }}
{% endif %}
{% endfor %}
 class class-default
  fair-queue
!

{# ── Apply to Interface ── #}
interface {{ interface }}
 service-policy {{ direction }} {{ policy_name }}
