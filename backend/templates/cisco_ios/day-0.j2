! ===== Day-0 Bootstrap: {{ hostname }} (Cisco IOS) =====
enable
configure terminal
!
hostname {{ hostname }}
{% if role == 'distribution' %}
ip routing
{% endif %}
ip domain-name cognishield.lab
no ip domain-lookup
service password-encryption
username {{ ssh_user }} privilege 15 secret {{ ssh_password }}
enable secret {{ ssh_password }}

interface {{ mgmt_interface }}
{% if mgmt_l3_interface %}
 no switchport
{% endif %}
 ip address {{ mgmt_ip }} {{ subnet_mask }}
 no shutdown
 exit
!
crypto key generate rsa modulus 2048
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
line vty 0 4
 transport input ssh
 login local
 exec-timeout 30 0
line con 0
 login local
 exec-timeout 30 0
!
{% if snmp_community %}
snmp-server community {{ snmp_community }} RO
{% if snmp_location %}
snmp-server location {{ snmp_location }}
{% endif %}
{% if snmp_contact %}
snmp-server contact {{ snmp_contact }}
{% endif %}
snmp-server enable traps snmp linkdown linkup coldstart
snmp-server enable traps syslog
{% if snmp_host_ip %}
snmp-server host {{ snmp_host_ip }} version 2c {{ snmp_community }}
{% endif %}
!
{% endif %}

lldp run
cdp run

{% if syslog_host_ip %}
logging host {{ syslog_host_ip }} transport udp port 6514
logging trap informational
logging source-interface {{ mgmt_interface }}
!
{% endif %}

{% if ntp_server_ip %}
ntp server {{ ntp_server_ip }}
!
{% endif %}

no ip http server
!
end
write memory
