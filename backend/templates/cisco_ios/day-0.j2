! ===== Day-0 Bootstrap: {{ hostname }} (Cisco IOS) =====
enable
configure terminal
!
hostname {{ hostname }}
!
interface {{ mgmt_interface }}
 ip address {{ mgmt_ip }} {{ subnet_mask }}
 no shutdown
 exit
!
ip default-gateway {{ gateway }}
!
username {{ ssh_user }} privilege 15 secret {{ ssh_password }}
!
ip domain-name mgmt.local
crypto key generate rsa modulus 2048
!
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
line vty 0 4
 login local
 transport input ssh
 exit
!
service password-encryption
no ip http server
no ip http secure-server
!
end
write memory
