# ===== Day-0 Bootstrap: {{ hostname }} (Huawei VRP) =====
system-view
#
sysname {{ hostname }}
#
interface {{ mgmt_interface }}
 ip address {{ mgmt_ip }} {{ mgmt_prefix_len if mgmt_prefix_len is defined else 24 }}
 undo shutdown
 quit
#
ip route-static 0.0.0.0 0.0.0.0 {{ gateway }}
#
stelnet server enable
#
aaa
 local-user {{ ssh_user }} password irreversible-cipher {{ ssh_password }}
 local-user {{ ssh_user }} privilege level 15
 local-user {{ ssh_user }} service-type ssh
 quit
#
ssh user {{ ssh_user }} authentication-type password
ssh user {{ ssh_user }} service-type stelnet
#
user-interface vty 0 4
 authentication-mode aaa
 protocol inbound ssh
 user privilege level 15
 quit
#
{% if snmp_community %}
snmp-agent
snmp-agent community read {{ snmp_community }}
{% if snmp_location %}
snmp-agent sys-info location {{ snmp_location }}
{% endif %}
{% if snmp_contact %}
snmp-agent sys-info contact {{ snmp_contact }}
{% endif %}
{% if snmp_host_ip %}
snmp-agent target-host trap address udp-domain {{ snmp_host_ip }} params securityname {{ snmp_community }}
{% endif %}
#
{% endif %}
{% if syslog_host_ip %}
info-center loghost {{ syslog_host_ip }}
#
{% endif %}
{% if ntp_server_ip %}
ntp-service unicast-server {{ ntp_server_ip }}
#
{% endif %}
return
save force
