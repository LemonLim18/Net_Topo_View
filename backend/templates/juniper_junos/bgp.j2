set routing-options autonomous-system {{ asn }}
set routing-options router-id {{ router_id }}
{% for neighbor in neighbors %}
set protocols bgp group external-peers type external
set protocols bgp group external-peers neighbor {{ neighbor.ip }} peer-as {{ neighbor.remote_as }}
{% if neighbor.description is defined and neighbor.description %}
set protocols bgp group external-peers neighbor {{ neighbor.ip }} description "{{ neighbor.description }}"
{% endif %}
{% if neighbor.update_source is defined and neighbor.update_source %}
set protocols bgp group external-peers local-address {{ neighbor.update_source }}
{% endif %}
{% endfor %}
{% if networks is defined and networks %}
{% for net in networks %}
set policy-options policy-statement bgp-export term {{ loop.index }} from route-filter {{ net.prefix }}/{{ net.prefix_length | default(24) }} exact
set policy-options policy-statement bgp-export term {{ loop.index }} then accept
{% endfor %}
set protocols bgp group external-peers export bgp-export
{% endif %}
