! ===== Strict Rollback: {{ hostname }} (Cisco IOS-XE) =====
enable
configure terminal
!
interface {{ mgmt_interface }}
 shutdown
 no ip address
 exit
!
no username {{ ssh_user }}
!
line vty 0 4
 transport input none
 exit
!
no ip ssh version 2
!
no ip default-gateway {{ gateway }}
!
no netconf-yang
no restconf
!
no ip http authentication local
no ip http secure-server
no ip http server
!
end
write memory
