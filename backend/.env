# ── Topology Crawler (M1 BFS Engine) ──────────────────────────
# Seeds = management IPs of devices to poll directly
# For partial lab: use only the running group's IPs
CRAWL_SEEDS=192.168.1.42,192.168.1.43,192.168.1.46,192.168.1.47,192.168.1.48
CRAWL_USER=cognishield
CRAWL_PASSWORD=CogniShield@Lab2026
CRAWL_DRIVER=auto
# Per-device credential overrides (IP:username:password, comma-separated)
CRAWL_CRED_OVERRIDES=192.168.1.43:cognishield:Admin@Lab2026,192.168.1.48:cognishield:Admin@Lab2026
CRAWL_WORKERS=6
CRAWL_AUTO_SUBNET_DISCOVERY=true
# Empty means derive /24 subnets from effective seeds; set explicit CIDRs to scope discovery.
CRAWL_DISCOVERY_SUBNETS=
CRAWL_DISCOVERY_PORT=22
CRAWL_DISCOVERY_TIMEOUT_MS=250
CRAWL_DISCOVERY_WORKERS=64
CRAWL_DISCOVERY_MAX_HOSTS=512

