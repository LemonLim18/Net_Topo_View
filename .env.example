# ─────────────────────────────────────────────────────────
# NetTopoView / CogniShield — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Network Discovery ──
CRAWL_SEEDS=192.168.1.1
CRAWL_USER=
CRAWL_PASSWORD=
CRAWL_DRIVER=cisco_ios
CRAWL_WORKERS=6

# ── InfluxDB ──
INFLUXDB_URL=http://192.168.1.250:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=netauto
INFLUXDB_BUCKET=telegraf
INFLUXDB_ADMIN_PASSWORD=adminpassword123

# ── Google Gemini LLM ──
GEMINI_API_KEY=

# ── NetBox (optional) ──
NETBOX_URL=
NETBOX_TOKEN=

# ── Authentication ──
JWT_SECRET_KEY=change-me-in-production
DEFAULT_ADMIN_PASSWORD=admin
